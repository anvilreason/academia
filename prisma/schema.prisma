generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  passwordSalt String   @map("password_salt")
  passwordIterations Int @default(100000) @map("password_iterations")
  passwordAlgorithm String @default("pbkdf2-sha256") @map("password_algorithm")
  name         String?
  status       String   @default("active")
  emailVerifiedAt DateTime? @map("email_verified_at")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  @@map("users")
}

model AuthRateLimit {
  id          String    @id @default(uuid())
  action      String
  subjectHash String    @map("subject_hash")
  windowKey   String    @map("window_key")
  count       Int       @default(1)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@unique([action, subjectHash, windowKey])
  @@map("auth_rate_limits")
}

model LearningNode {
  id        String    @id @default(uuid())
  slug      String    @unique
  title     String
  priceFen  Int       @default(0) @map("price_fen")
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("learning_nodes")
}

model LearningSession {
  id            String    @id @default(uuid())
  nodeSlug      String    @map("node_slug")
  userId        String?   @map("user_id")
  guestId       String?   @map("guest_id")
  status        String    @default("active")
  turnCount     Int       @default(0) @map("turn_count")
  progress      Int       @default(0)
  promptVersion String    @default("socratic-zh-v1") @map("prompt_version")
  completedAt   DateTime? @map("completed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  @@index([userId, updatedAt])
  @@index([guestId])
  @@map("learning_sessions")
}

model Message {
  id             String    @id @default(uuid())
  sessionId      String    @map("session_id")
  role           String
  content        String
  idempotencyKey String?   @map("idempotency_key")
  inputTokens    Int?      @map("input_tokens")
  outputTokens   Int?      @map("output_tokens")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  @@unique([sessionId, idempotencyKey, role])
  @@map("messages")
}

model Order {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  nodeSlug       String    @map("node_slug")
  amountFen      Int       @map("amount_fen")
  status         String    @default("pending")
  paymentMode    String    @default("test") @map("payment_mode")
  idempotencyKey String    @map("idempotency_key")
  confirmedAt    DateTime? @map("confirmed_at")
  refundedAt     DateTime? @map("refunded_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  @@unique([userId, idempotencyKey])
  @@map("orders")
}

model NodeEntitlement {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  nodeSlug      String    @map("node_slug")
  sourceOrderId String?   @map("source_order_id")
  status        String    @default("active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  @@unique([userId, nodeSlug])
  @@map("node_entitlements")
}

model LearningNote {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  sessionId String    @map("session_id")
  nodeSlug  String    @map("node_slug")
  title     String
  content   String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("learning_notes")
}

model LlmCallLog {
  id            String    @id @default(uuid())
  sessionId     String?   @map("session_id")
  userId        String?   @map("user_id")
  guestId       String?   @map("guest_id")
  modelAlias    String    @map("model_alias")
  providerModel String    @map("provider_model")
  status        String
  inputTokens   Int       @default(0) @map("input_tokens")
  outputTokens  Int       @default(0) @map("output_tokens")
  reservedFen   Int       @default(0) @map("reserved_fen")
  actualFen     Int       @default(0) @map("actual_fen")
  errorCode     String?   @map("error_code")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  @@map("llm_call_logs")
}

model DailyCostQuota {
  id          String    @id @default(uuid())
  dateKey     String    @unique @map("date_key")
  reservedFen Int       @default(0) @map("reserved_fen")
  actualFen   Int       @default(0) @map("actual_fen")
  limitFen    Int       @default(5000) @map("limit_fen")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@map("daily_cost_quotas")
}

model GuestTrialUsage {
  id        String    @id @default(uuid())
  guestId   String    @map("guest_id")
  dateKey   String    @map("date_key")
  sessionId String    @map("session_id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([guestId, dateKey])
  @@map("guest_trial_usage")
}

model UserProgram {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  programSlug String    @map("program_slug")
  status      String    @default("active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@unique([userId, programSlug])
  @@map("user_programs")
}

model UserCoursePlan {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  programSlug String    @map("program_slug")
  courseSlug  String    @map("course_slug")
  status      String    @default("planned")
  recognitionType String? @map("recognition_type")
  sourceCourseSlug String? @map("source_course_slug")
  recognizedCredits Int @default(0) @map("recognized_credits")
  remainingCredits Int @default(0) @map("remaining_credits")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@unique([userId, courseSlug])
  @@map("user_course_plans")
}

model PracticeProject {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  title     String
  context   String
  goal      String
  status    String    @default("active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([userId, updatedAt])
  @@map("practice_projects")
}

model AgentThread {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  title     String    @default("新的思考")
  status    String    @default("active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([userId, updatedAt])
  @@map("agent_threads")
}

model AgentMessage {
  id             String    @id @default(uuid())
  threadId       String    @map("thread_id")
  role           String
  content        String
  idempotencyKey String?   @map("idempotency_key")
  inputTokens    Int?      @map("input_tokens")
  outputTokens   Int?      @map("output_tokens")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  @@unique([threadId, idempotencyKey, role])
  @@map("agent_messages")
}

model MemoryItem {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  kind         String
  contextLabel String    @map("context_label")
  content      String
  sourceType   String    @map("source_type")
  sourceId     String    @map("source_id")
  salience     Int       @default(50)
  lastUsedAt   DateTime? @map("last_used_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  @@unique([userId, sourceType, sourceId])
  @@index([userId, updatedAt])
  @@map("memory_items")
}

model ExamAttempt {
  id                    String    @id @default(uuid())
  userId                String    @map("user_id")
  sessionId             String    @map("session_id")
  nodeSlug              String    @map("node_slug")
  attemptNumber         Int       @map("attempt_number")
  score                 Int
  gradePointHundredths  Int       @map("grade_point_hundredths")
  creditsAttempted      Int       @map("credits_attempted")
  creditsEarned         Int       @map("credits_earned")
  passed                Boolean
  weakTopicsJson        String    @map("weak_topics_json")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  deletedAt             DateTime? @map("deleted_at")

  @@index([userId, nodeSlug])
  @@map("exam_attempts")
}

model WalletAccount {
  id                String    @id @default(uuid())
  userId            String    @unique @map("user_id")
  balanceFen        Int       @default(0) @map("balance_fen")
  completedSpendFen Int       @default(0) @map("completed_spend_fen")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  @@map("wallet_accounts")
}

model WalletTransaction {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  type        String
  amountFen   Int       @map("amount_fen")
  referenceId String?   @map("reference_id")
  description String
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@unique([userId, type, referenceId])
  @@map("wallet_transactions")
}

model AnalyticsEvent {
  id                 String    @id @default(uuid())
  eventName          String    @map("event_name")
  schemaVersion      Int       @default(1) @map("schema_version")
  dateKey            String    @map("date_key")
  userId             String?   @map("user_id")
  guestId            String?   @map("guest_id")
  analyticsSessionId String?   @map("analytics_session_id")
  path                String?
  referrerHost        String?  @map("referrer_host")
  schoolSlug          String?  @map("school_slug")
  programSlug         String?  @map("program_slug")
  courseSlug          String?  @map("course_slug")
  trackingLinkId      String?  @map("tracking_link_id")
  acquisitionSource   String?  @map("acquisition_source")
  acquisitionMedium   String?  @map("acquisition_medium")
  acquisitionCampaign String?  @map("acquisition_campaign")
  country             String?
  region              String?
  city                String?
  timezone            String?
  deviceCategory      String?  @map("device_category")
  engagementMs        Int?     @map("engagement_ms")
  propertiesJson      String    @default("{}") @map("properties_json")
  isTest              Boolean   @default(false) @map("is_test")
  occurredAt          DateTime  @map("occurred_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")

  @@index([dateKey, eventName])
  @@index([userId, occurredAt])
  @@index([guestId, occurredAt])
  @@index([programSlug, occurredAt])
  @@index([acquisitionCampaign, occurredAt])
  @@map("analytics_events")
}

model AnalyticsIdentityLink {
  id        String    @id @default(uuid())
  guestId   String    @map("guest_id")
  userId    String    @map("user_id")
  linkedAt  DateTime  @map("linked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([guestId, userId])
  @@map("analytics_identity_links")
}

model AdminMember {
  id           String    @id @default(uuid())
  userId       String?   @map("user_id")
  email        String    @unique
  role         String    @default("viewer")
  status       String    @default("active")
  lastAccessAt DateTime? @map("last_access_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  @@map("admin_members")
}

model TrackingLink {
  id         String    @id @default(uuid())
  code       String    @unique
  name       String
  targetPath String    @map("target_path")
  source     String
  medium     String
  campaign   String
  ownerEmail String    @map("owner_email")
  status     String    @default("active")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  @@index([campaign, createdAt])
  @@map("tracking_links")
}

model AdminAuditLog {
  id           String    @id @default(uuid())
  adminEmail   String    @map("admin_email")
  action       String
  resourceType String?   @map("resource_type")
  resourceId   String?   @map("resource_id")
  metadataJson String    @default("{}") @map("metadata_json")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  @@index([adminEmail, createdAt])
  @@map("admin_audit_logs")
}

model AnswerPathEnrollment {
  id                String    @id @default(uuid())
  userId            String    @map("user_id")
  pathSlug          String    @map("path_slug")
  pathVersion       String    @map("path_version")
  contentVersion    String    @map("content_version")
  evaluationVersion String    @map("evaluation_version")
  currentStep       String    @default("baseline") @map("current_step")
  status            String    @default("active")
  outcomeStatus     String?   @map("outcome_status")
  startedAt         DateTime  @map("started_at")
  completedAt       DateTime? @map("completed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  @@unique([userId, pathSlug])
  @@index([userId, updatedAt])
  @@map("answer_path_enrollments")
}

model BaselineDiagnosis {
  id                 String    @id @default(uuid())
  enrollmentId       String    @unique @map("enrollment_id")
  userId             String    @map("user_id")
  projectTitle       String    @map("project_title")
  ideaSummary        String    @map("idea_summary")
  targetUser         String    @map("target_user")
  currentEvidence    String    @map("current_evidence")
  biggestUncertainty String    @map("biggest_uncertainty")
  confidence         Int
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  @@map("baseline_diagnoses")
}

model EvidenceSubmission {
  id                 String    @id @default(uuid())
  enrollmentId       String    @map("enrollment_id")
  userId             String    @map("user_id")
  stepKey            String    @map("step_key")
  evidenceType       String    @map("evidence_type")
  subjectLabel       String    @map("subject_label")
  content            String
  provenance         String
  observedAt         DateTime? @map("observed_at")
  verificationStatus String    @default("user_attested") @map("verification_status")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  @@index([enrollmentId, createdAt])
  @@map("evidence_submissions")
}

model AnswerPathArtifact {
  id                String    @id @default(uuid())
  userId            String    @map("user_id")
  enrollmentId      String    @map("enrollment_id")
  title             String
  artifactType      String    @map("artifact_type")
  version           Int       @default(1)
  content           String
  userContribution  String    @map("user_contribution")
  agentContribution String    @map("agent_contribution")
  visibility        String    @default("private")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  @@unique([enrollmentId, version])
  @@map("answer_path_artifacts")
}

model RubricEvaluation {
  id               String    @id @default(uuid())
  enrollmentId     String    @map("enrollment_id")
  artifactId       String    @map("artifact_id")
  rubricVersion    String    @map("rubric_version")
  evaluatorType    String    @default("agent") @map("evaluator_type")
  scoreDetailJson  String    @map("score_detail_json")
  strengths        String
  weaknesses       String
  feedback         String
  requiredRevision Boolean   @default(true) @map("required_revision")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  @@index([enrollmentId, createdAt])
  @@map("rubric_evaluations")
}

model RealWorldOutcome {
  id             String    @id @default(uuid())
  enrollmentId   String    @unique @map("enrollment_id")
  userId         String    @map("user_id")
  decision       String
  observedResult String    @map("observed_result")
  nextAction     String    @map("next_action")
  uncertainty    String
  happenedAt     DateTime  @map("happened_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  @@map("real_world_outcomes")
}

model CapabilityEvidence {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  enrollmentId   String    @map("enrollment_id")
  capabilityId   String    @map("capability_id")
  level          Int
  sourceType     String    @map("source_type")
  sourceId       String    @map("source_id")
  confidence     Int
  verifiedAt     DateTime  @map("verified_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  @@unique([userId, capabilityId, sourceType, sourceId])
  @@map("capability_evidence")
}

model ResultRecognition {
  id                String    @id @default(uuid())
  userId            String    @map("user_id")
  enrollmentId      String    @map("enrollment_id")
  pathSlug          String    @map("path_slug")
  artifactId        String    @map("artifact_id")
  courseSlug        String    @map("course_slug")
  programSlug       String    @map("program_slug")
  capabilityId      String    @map("capability_id")
  scope             String    @default("practice")
  status            String    @default("validated")
  recognizedCredits Int       @map("recognized_credits")
  graphVersion      String    @map("graph_version")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  @@unique([userId, enrollmentId])
  @@index([userId, courseSlug])
  @@map("result_recognitions")
}

model ArtifactShare {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  artifactId   String    @unique @map("artifact_id")
  enrollmentId String    @map("enrollment_id")
  publicSlug   String    @unique @map("public_slug")
  shareTitle   String    @map("share_title")
  shareSummary String    @map("share_summary")
  status       String    @default("active")
  publishedAt  DateTime  @map("published_at")
  revokedAt    DateTime? @map("revoked_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  @@index([userId, updatedAt])
  @@map("artifact_shares")
}
