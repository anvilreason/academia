generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  passwordSalt String   @map("password_salt")
  passwordIterations Int @default(100000) @map("password_iterations")
  passwordAlgorithm String @default("pbkdf2-sha256") @map("password_algorithm")
  name         String?
  status       String   @default("active")
  emailVerifiedAt DateTime? @map("email_verified_at")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  @@map("users")
}

model AuthRateLimit {
  id          String    @id @default(uuid())
  action      String
  subjectHash String    @map("subject_hash")
  windowKey   String    @map("window_key")
  count       Int       @default(1)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@unique([action, subjectHash, windowKey])
  @@map("auth_rate_limits")
}

model LearningNode {
  id        String    @id @default(uuid())
  slug      String    @unique
  title     String
  priceFen  Int       @default(0) @map("price_fen")
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("learning_nodes")
}

model LearningSession {
  id            String    @id @default(uuid())
  nodeSlug      String    @map("node_slug")
  userId        String?   @map("user_id")
  guestId       String?   @map("guest_id")
  status        String    @default("active")
  turnCount     Int       @default(0) @map("turn_count")
  progress      Int       @default(0)
  promptVersion String    @default("socratic-zh-v1") @map("prompt_version")
  completedAt   DateTime? @map("completed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  @@index([userId, updatedAt])
  @@index([guestId])
  @@map("learning_sessions")
}

model Message {
  id             String    @id @default(uuid())
  sessionId      String    @map("session_id")
  role           String
  content        String
  idempotencyKey String?   @map("idempotency_key")
  inputTokens    Int?      @map("input_tokens")
  outputTokens   Int?      @map("output_tokens")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  @@unique([sessionId, idempotencyKey, role])
  @@map("messages")
}

model Order {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  nodeSlug       String    @map("node_slug")
  amountFen      Int       @map("amount_fen")
  status         String    @default("pending")
  idempotencyKey String    @map("idempotency_key")
  confirmedAt    DateTime? @map("confirmed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  @@unique([userId, idempotencyKey])
  @@map("orders")
}

model NodeEntitlement {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  nodeSlug      String    @map("node_slug")
  sourceOrderId String?   @map("source_order_id")
  status        String    @default("active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  @@unique([userId, nodeSlug])
  @@map("node_entitlements")
}

model LearningNote {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  sessionId String    @map("session_id")
  nodeSlug  String    @map("node_slug")
  title     String
  content   String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("learning_notes")
}

model LlmCallLog {
  id            String    @id @default(uuid())
  sessionId     String?   @map("session_id")
  userId        String?   @map("user_id")
  guestId       String?   @map("guest_id")
  modelAlias    String    @map("model_alias")
  providerModel String    @map("provider_model")
  status        String
  inputTokens   Int       @default(0) @map("input_tokens")
  outputTokens  Int       @default(0) @map("output_tokens")
  reservedFen   Int       @default(0) @map("reserved_fen")
  actualFen     Int       @default(0) @map("actual_fen")
  errorCode     String?   @map("error_code")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  @@map("llm_call_logs")
}

model DailyCostQuota {
  id          String    @id @default(uuid())
  dateKey     String    @unique @map("date_key")
  reservedFen Int       @default(0) @map("reserved_fen")
  actualFen   Int       @default(0) @map("actual_fen")
  limitFen    Int       @default(5000) @map("limit_fen")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@map("daily_cost_quotas")
}

model GuestTrialUsage {
  id        String    @id @default(uuid())
  guestId   String    @map("guest_id")
  dateKey   String    @map("date_key")
  sessionId String    @map("session_id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([guestId, dateKey])
  @@map("guest_trial_usage")
}

model UserProgram {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  programSlug String    @map("program_slug")
  status      String    @default("active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@unique([userId, programSlug])
  @@map("user_programs")
}

model UserCoursePlan {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  programSlug String    @map("program_slug")
  courseSlug  String    @map("course_slug")
  status      String    @default("planned")
  recognitionType String? @map("recognition_type")
  sourceCourseSlug String? @map("source_course_slug")
  recognizedCredits Int @default(0) @map("recognized_credits")
  remainingCredits Int @default(0) @map("remaining_credits")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@unique([userId, courseSlug])
  @@map("user_course_plans")
}

model PracticeProject {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  title     String
  context   String
  goal      String
  status    String    @default("active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([userId, updatedAt])
  @@map("practice_projects")
}

model AgentThread {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  title     String    @default("新的思考")
  status    String    @default("active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([userId, updatedAt])
  @@map("agent_threads")
}

model AgentMessage {
  id             String    @id @default(uuid())
  threadId       String    @map("thread_id")
  role           String
  content        String
  idempotencyKey String?   @map("idempotency_key")
  inputTokens    Int?      @map("input_tokens")
  outputTokens   Int?      @map("output_tokens")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  @@unique([threadId, idempotencyKey, role])
  @@map("agent_messages")
}

model MemoryItem {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  kind         String
  contextLabel String    @map("context_label")
  content      String
  sourceType   String    @map("source_type")
  sourceId     String    @map("source_id")
  salience     Int       @default(50)
  lastUsedAt   DateTime? @map("last_used_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  @@unique([userId, sourceType, sourceId])
  @@index([userId, updatedAt])
  @@map("memory_items")
}

model ExamAttempt {
  id                    String    @id @default(uuid())
  userId                String    @map("user_id")
  sessionId             String    @map("session_id")
  nodeSlug              String    @map("node_slug")
  attemptNumber         Int       @map("attempt_number")
  score                 Int
  gradePointHundredths  Int       @map("grade_point_hundredths")
  creditsAttempted      Int       @map("credits_attempted")
  creditsEarned         Int       @map("credits_earned")
  passed                Boolean
  weakTopicsJson        String    @map("weak_topics_json")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  deletedAt             DateTime? @map("deleted_at")

  @@index([userId, nodeSlug])
  @@map("exam_attempts")
}

model WalletAccount {
  id                String    @id @default(uuid())
  userId            String    @unique @map("user_id")
  balanceFen        Int       @default(0) @map("balance_fen")
  completedSpendFen Int       @default(0) @map("completed_spend_fen")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  @@map("wallet_accounts")
}

model WalletTransaction {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  type        String
  amountFen   Int       @map("amount_fen")
  referenceId String?   @map("reference_id")
  description String
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@unique([userId, type, referenceId])
  @@map("wallet_transactions")
}
