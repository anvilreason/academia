{
  "name": "academia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:integration": "TEST_BASE_URL=http://localhost:3001 node --experimental-strip-types --test tests/integration.test.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@prisma/client": "^7.9.0",
    "@tanstack/react-query": "^5.101.4",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.26.0",
    "next": "16.2.6",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitejs/plugin-rsc": "^0.5.26",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prisma": "^7.9.0",
    "react-server-dom-webpack": "^19.2.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vinext": "^0.0.50",
    "vite": "^8.0.13",
    "wrangler": "^4.92.0"
  },
  "type": "module"
}
