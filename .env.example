# Local development only. Never commit real values.
AUTH_SECRET=replace-with-a-long-random-value
# Comma-separated owner accounts for the protected Observatory.
ADMIN_OWNER_EMAILS=
# Set one provider as the default: kimi, openai or anthropic.
LLM_PROVIDER=kimi
MOONSHOT_API_KEY=replace-with-your-api-key
KIMI_MODEL=kimi-k2.6
KIMI_REASONING_EFFORT=low
OPENAI_API_KEY=replace-with-your-api-key
OPENAI_MODEL=gpt-5.6-sol
ANTHROPIC_API_KEY=replace-with-your-api-key
ANTHROPIC_MODEL=claude-sonnet-5
PAYMENT_MODE=test
USD_CNY_RATE=7.2
